# Configuración con credenciales reales (usar appsettings.example.json como base)
appsettings.json
appsettings.*.json
!appsettings.example.json

# Variables de entorno para Docker (usar .env.example como base)
.env
.env.*
!.env.example

# Salida de compilación
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
*.user
*.suo

# Previsualizaciones generadas por --previsualizar
previsualizacion-*.html

# Estado de corrida del DAO de archivo: el piso de la ventana de conciliación. Es por entorno,
# no un fixture como envios.json, y lo reescribe cada corrida de --respuestas.
conciliacion.json

# Bitácoras de ejecución
logs/
Logs/

# Herramientas y editores
.claude/
.vs/
.vscode/
.idea/
*.swp

# macOS
.DS_Store
