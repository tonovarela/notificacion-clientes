[Unit]
Description=Notificación de facturas a clientes (corrida diaria)
Documentation=file:/opt/notificacion-clientes/DESPLIEGUE.md
# El servicio no arranca antes de que Docker esté listo. Requires (y no sólo After) hace que la
# corrida falle de inmediato con un motivo claro si el demonio no está, en vez de colgarse.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# Proceso de una sola pasada: corre, notifica, escribe la bitácora y termina.
Type=oneshot

# Usuario sin privilegios que pertenece al grupo 'docker'. Cámbialo por el real:
#   sudo useradd --system --shell /usr/sbin/nologin notificaciones
#   sudo usermod -aG docker notificaciones
User=notificaciones
Group=notificaciones

WorkingDirectory=/opt/notificacion-clientes
ExecStart=/opt/notificacion-clientes/run.sh

# Tope de duración de la corrida. Descargar los CFDI de todo un día y mandarlos por SMTP puede
# tardar; 30 minutos deja margen sin dejar un proceso colgado hasta la corrida siguiente.
TimeoutStartSec=30min

# Si systemd tiene que matar la corrida por timeout, el contenedor quedaría huérfano y su --name
# bloquearía la corrida del día siguiente. Esto lo limpia.
ExecStopPost=-/usr/bin/docker rm -f notificacion-clientes

# Un reintento inmediato repetiría correos ya enviados: si falla, falla y avisa.
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=notificacion-clientes

# --- Endurecimiento ----------------------------------------------------------
# El trabajo real ocurre dentro del contenedor; este proceso sólo habla con el socket de Docker.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Único directorio donde necesita escribir (bitácoras montadas en el contenedor).
ReadWritePaths=/opt/notificacion-clientes/logs

[Install]
WantedBy=multi-user.target
