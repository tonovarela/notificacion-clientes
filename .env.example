# Copia este archivo como .env y ajusta los valores reales.
# Formato de .NET: cada ':' de appsettings.json se escribe como '__'.

# Zona horaria del contenedor (afecta las fechas que se imprimen en el correo)
TZ=America/Mexico_City

# --- Base de datos -----------------------------------------------------------
ConnectionStrings__SqlServer=Server=192.168.2.217,1433;Database=Lito;User Id=sa;Password=CAMBIAR;TrustServerCertificate=True;

# --- API de facturas ---------------------------------------------------------
ApiFacturas__UrlDescarga=http://192.168.2.222/proveedores/api/facturas/movimiento
ApiFacturas__TimeoutSegundos=60

# --- Correo: plantilla y logo (rutas relativas dentro de la imagen) -----------
Correo__Plantilla=Plantillas/notificacion-cliente.html
Correo__PlantillaVendedor=Plantillas/notificacion-vendedor.html
Correo__PlantillaCobranza=Plantillas/cobranza-vencida.html
Correo__PlantillaCobranzaRecordatorio=Plantillas/cobranza-recordatorio.html
Correo__Logo=Recursos/logo.png

# --- Rango de la consulta de facturas -----------------------------------------
# Cuantos dias hacia atras se incluyen. 0 = solo las de hoy, que es lo normal.
# Ampliarlo hace que la misma factura se notifique en varias corridas; con el seguimiento
# encendido eso ademas abriria un envio nuevo cada dia por la misma factura.
Facturas__DiasAtras=0

# --- Seguimiento: acuse y recordatorio ----------------------------------------
# Apagado por omision. Encenderlo exige haber corrido deploy/sql/001-seguimiento.sql
# y que el usuario de la base tenga ESCRITURA sobre la base CorreosCXC.
Seguimiento__Habilitado=false

# Dias que un envio de cobranza sigue esperando respuesta antes de cerrarse.
# Siete cubre el ciclo semanal: cuando sale el correo del martes siguiente, el de la
# semana pasada ya no espera nada. Lo que no se cierra hace crecer sin limite la
# ventana de busqueda IMAP de la conciliacion.
Seguimiento__DiasVigencia=7

# Tope duro de cuantos dias hacia atras se lee el buzon, pase lo que pase.
Seguimiento__DiasVentanaMaxima=30

# --- IMAP: lectura del buzon para detectar respuestas -------------------------
# Vacios = se usan las credenciales de Smtp. Es la misma cuenta.
# La carpeta se abre SIEMPRE en solo lectura: no marca correos como leidos.
Imap__Host=imap.gmail.com
Imap__Puerto=993
Imap__Usuario=
Imap__Password=
Imap__Carpeta=INBOX

# --- Bitácora: directorio montado en ./logs del host -------------------------
Bitacora__Ruta=Logs

# --- SMTP --------------------------------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Puerto=465
Smtp__Usuario=cxc@litoprocess.com
Smtp__Password=CAMBIAR
Smtp__UsarSsl=true
Smtp__RemitenteNombre=Facturación Litoprocess
Smtp__RemitenteEmail=cxc@litoprocess.com

# ModoPrueba=true redirige TODOS los correos a Smtp__CorreoPrueba.
# Ponlo en false sólo cuando de verdad quieras notificar a los clientes.
Smtp__ModoPrueba=true
Smtp__CorreoPrueba=mestelles@litoprocess.com

# Mismo interruptor, pero sólo para el aviso a vendedores (--vendedores). Es independiente:
# permite dejar el proceso de clientes en producción mientras el de vendedores se prueba.
# Si se omiten, heredan Smtp__ModoPrueba y Smtp__CorreoPrueba.
Smtp__ModoPruebaVendedores=true
Smtp__CorreoPruebaVendedores=mestelles@litoprocess.com

# Copia oculta (CCO) de cada correo. Varias direcciones separadas por coma.
# El cliente no las ve. Reciben copia siempre, incluso con ModoPrueba en true.
Smtp__CopiaOculta=cxc@litoprocess.com
